{
  "schema": 1,
  "comment": "Target link-ABI wrappers that are not represented in LLVM IR or public headers. Kept outside the build-time-generated symbol indexes (compiler/tools/gen_link_index.zig) so it survives regeneration.",
  "targets": {
    "linux": {
      "atexit": {
        "symbol": "__cxa_atexit",
        "providers": [
          {
            "kind": 1,
            "lib": "libc.so.6",
            "symbol": "__cxa_atexit"
          }
        ],
        "extra_args": [
          {
            "type": "ptr",
            "const": 0
          },
          {
            "type": "ptr",
            "const": 0
          }
        ]
      }
    }
  },
  "aliases": {
    "windows": {
      "snprintf": "_snprintf",
      "vsnprintf": "_vsnprintf"
    }
  }
}
