{
  "suite": "compcert-smoke",
  "description": "CompCert regression portable cross-ABI smoke",
  "root": "{SUITES}/CompCert/test",
  "upstream": "https://github.com/AbsInt/CompCert-small-tests",
  "commit": "71c682d6b3a74e1a7d5da30285b5735761031da3",
  "license": "GPL-2.0-or-later",
  "tiers": [
    "nightly"
  ],
  "expected_dir": "regression/Results",
  "expected_ext": "",
  "expected_exit": 0,
  "timeout": 30,
  "cases": [
    {
      "id": "bool",
      "source": "regression/bool.c",
      "expected_stdout": "regression/Results/bool"
    },
    {
      "id": "casts1",
      "source": "regression/casts1.c",
      "expected_stdout": "regression/Results/casts1"
    },
    {
      "id": "casts2",
      "source": "regression/casts2.c",
      "expected_stdout": "regression/Results/casts2"
    },
    {
      "id": "char1",
      "source": "regression/char1.c",
      "expected_stdout": "regression/Results/char1"
    },
    {
      "id": "compar",
      "source": "regression/compar.c",
      "expected_stdout": "regression/Results/compar"
    },
    {
      "id": "decl1",
      "source": "regression/decl1.c",
      "expected_stdout": "regression/Results/decl1"
    },
    {
      "id": "decl2",
      "source": "regression/decl2.c",
      "expected_stdout": "regression/Results/decl2"
    },
    {
      "id": "expr1",
      "source": "regression/expr1.c",
      "expected_stdout": "regression/Results/expr1"
    },
    {
      "id": "expr5",
      "source": "regression/expr5.c",
      "expected_stdout": "regression/Results/expr5"
    },
    {
      "id": "for1",
      "source": "regression/for1.c",
      "expected_stdout": "regression/Results/for1"
    },
    {
      "id": "for2",
      "source": "regression/for2.c",
      "expected_stdout": "regression/Results/for2"
    },
    {
      "id": "int64",
      "source": "regression/int64.c",
      "expected_stdout": "regression/Results/int64"
    },
    {
      "id": "binops",
      "source": "regression/binops.c",
      "expected_stdout": "regression/Results/binops",
      "skip_by_target": {
        "x86_64-windows": "Windows long-double formatting differs from reference",
        "i686-windows": "Windows long-double formatting differs from reference"
      }
    },
    {
      "id": "bitfields1",
      "source": "regression/bitfields1.c",
      "expected_stdout": "regression/Results/bitfields1"
    },
    {
      "id": "bitfields2",
      "source": "regression/bitfields2.c",
      "expected_stdout": "regression/Results/bitfields2"
    },
    {
      "id": "bitfields10",
      "source": "regression/bitfields10.c",
      "expected_stdout": "regression/Results/bitfields10"
    },
    {
      "id": "casts3",
      "source": "regression/casts3.c",
      "expected_stdout": "regression/Results/casts3",
      "timeout": 90
    },
    {
      "id": "consteval",
      "source": "regression/consteval.c",
      "expected_stdout": "regression/Results/consteval"
    },
    {
      "id": "expr6",
      "source": "regression/expr6.c",
      "expected_stdout": "regression/Results/expr6"
    },
    {
      "id": "funct3",
      "source": "regression/funct3.c",
      "expected_stdout": "regression/Results/funct3"
    },
    {
      "id": "funptr2",
      "source": "regression/funptr2.c",
      "expected_stdout": "regression/Results/funptr2"
    },
    {
      "id": "generic",
      "source": "regression/generic.c",
      "expected_stdout": "regression/Results/generic"
    },
    {
      "id": "ifconv",
      "source": "regression/ifconv.c",
      "expected_stdout": "regression/Results/ifconv"
    },
    {
      "id": "instrsel",
      "source": "regression/instrsel.c",
      "expected_stdout": "regression/Results/instrsel"
    }
  ]
}
