{
  "suite": "libc-test-regression",
  "description": "musl libc-test regression subset",
  "root": "{SUITES}/libc-test",
  "upstream": "https://github.com/kraj/libc-test",
  "commit": "b7ec467969a53756258778fa7d9b045f912d1c93",
  "license": "MIT",
  "tiers": [
    "full",
    "nightly"
  ],
